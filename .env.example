# Supabase project settings — Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The public URL this app is deployed at. Used to build the redirect link in
# password-reset emails. Set to http://localhost:3000 for local development
# and to your production URL (e.g. https://your-app.vercel.app) on Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — enables richer voice-search/voice-add-item understanding via the
# Gemini API (server-side only, never exposed to the browser). Get a free key
# at https://aistudio.google.com/apikey. If left unset, voice search still
# works fully using a built-in rule-based natural-language parser.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.0-flash

# Optional — sends Let's Split invite links by SMS via MSG91 (server-side
# only). Get MSG91_AUTH_KEY from the MSG91 dashboard's API keys section;
# MSG91_SENDER_ID is your 6-character DLT-registered sender ID (India
# requires DLT registration for transactional SMS — an invite text sent
# without one may be silently dropped by the carrier even though this app
# reports success). If left unset, invites still work fully via the
# copyable link, email, and "open in Messages" deep link.
# MSG91_AUTH_KEY=your-msg91-auth-key
# MSG91_SENDER_ID=MYSPCE
